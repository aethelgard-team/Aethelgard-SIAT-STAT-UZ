# ==========================================
# Aethelgard · SIAT Environment Variables
# ==========================================

# PostgreSQL DWH Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=siat_dwh
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/siat_dwh

# Google Gemini API Settings (LLM Orchestrator)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Optional Google Cloud Project ID
GOOGLE_PROJECT_ID=your_project_id_here
GOOGLE_PROJECT_NUMBER=your_project_number_here
